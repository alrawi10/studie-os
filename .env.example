# Kopiér til .env og udfyld (chmod 600 .env). Print aldrig indholdet, commit det aldrig.
# Udfyld KUN blokken for dit universitets platform (se "lms" i config/fag.json).

# --- Canvas (KU Absalon, CBS …) – officielt API ---------------------------------
# Konto → Indstillinger → "+ Nyt adgangstoken". URL skal slutte på /api/v1.
CANVAS_API_TOKEN=
CANVAS_API_URL=https://absalon.ku.dk/api/v1

# --- Moodle (AAU, RUC, ITU …) – mobilapp-token ----------------------------------
# Profil/Præferencer → Sikkerhedsnøgler → "Moodle mobile web service".
# MOODLE_URL=https://www.moodle.aau.dk
# MOODLE_TOKEN=

# --- Brightspace (AU, DTU Learn …) ----------------------------------------------
# Officielt OAuth-token hvis universitetet udsteder det, ellers browser-cookie (uofficielt).
# BRIGHTSPACE_URL=https://brightspace.au.dk
# BRIGHTSPACE_TOKEN=
# BRIGHTSPACE_COOKIE=

# --- itslearning (SDU …) – EKSPERIMENTEL, uofficielt mobilapp-API ----------------
# ITSLEARNING_URL=https://sdu.itslearning.com
# ITSLEARNING_REFRESH_TOKEN=
# ITSLEARNING_ACCESS_TOKEN=

# --- Valgfrit: deadlines fra kalender-feed (alle platforme) ----------------------
# Kalender → abonnér/eksportér (.ics). Flere URL'er adskilles med mellemrum.
# ICAL_URL=
